# ── Hermes gateway environment (template) ──────────────────────────────────
# Fill in the values, then write this to $HERMES_HOME/.env
# Atropos reads these same variables through core/detect.py + core/config.py.
# No hardcoded paths here — {{HERMES_HOME}} is substituted by atropos init.

# Telegram bot token (BotFather: /newbot)
TELEGRAM_BOT_TOKEN={{TELEGRAM_BOT_TOKEN}}

# Primary model router key (nain/omni use the OpenAI-compatible endpoint)
OPENAI_API_KEY={{OPENAI_API_KEY}}

# Router base URL. Leave empty to use the platform default.
OPENAI_BASE_URL={{OPENAI_BASE_URL}}

# Claude API key (used by the fusion layer / Claude fallback)
ANTHROPIC_API_KEY={{ANTHROPIC_API_KEY}}

# Where Hermes keeps its assets, hooks, scripts and logs.
HERMES_HOME={{HERMES_HOME}}

# Telegram channel (or chat) that receives bot activity logs.
# Used by the log-channel hook (templates/log-channel-hook.tmpl).
ATRA_LOG_CHANNEL={{ATRA_LOG_CHANNEL}}

# Comma-separated list of Telegram user IDs allowed to talk to the bot.
# "5838175445" is Artan's owner DM. "*" would allow everyone (NOT for guests —
# guests are gated separately by guest mode).
TELEGRAM_ALLOWED_USERS={{TELEGRAM_ALLOWED_USERS}}

# Timezone for the bot process (Asia/Tehran for ATRA).
TZ=Asia/Tehran
