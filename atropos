def cmd_config(args):
    if args.action == "get":
        if args.key:
            val = config.get(args.key)
            if val is None:
                _fail(f"key not found: {args.key}")
                sys.exit(1)
            print(json.dumps(val, ensure_ascii=False) if isinstance(val, (dict, list)) else val)
        else:
            print(config.dump_yaml(config.load()))
    elif args.action == "set":
        key, value = args.key, args.value
        parsed = _coerce(value)
        config.set_path(key, parsed)
        _ok(f"config set: {key} = {json.dumps(parsed, ensure_ascii=False)}")
    else:
        _fail(f"unknown config action: {args.action}")
        sys.exit(1)


def _coerce(value: str):
    """Try to parse `value` as JSON/bool/int/float, else keep as string."""
    if value.lower() in ("true", "yes", "on"):
        return True
    if value.lower() in ("false", "no", "off"):
        return False
    if value.lower() in ("null", "none"):
        return None
    if value.isdigit():
        return int(value)
    try:
        return json.loads(value)
    except Exception:
        return value


def cmd_route(args):
    # actions may appear in either positional slot ("route models nain" /
    # "route nain models" both mean list nain's models)
    _ACT = ("models", "chat", "omni", "health", "list", "status")
    for attr in ("action", "set_name"):
        if getattr(args, attr, None) in _ACT:
            args.action = getattr(args, attr)
            args.set_name = getattr(args, "set_name", None)
            if getattr(args, attr) == args.action and attr == "action":
                args.set_name = None
            else:
                args.set_name = None
            return _route_manage(args)
    if args.set_name:
        try:
            r = router.set_active(args.set_name)
            _ok(f"router set: {args.set_name}")
            for target, ok, msg in router.apply_all():
                if ok:
                    _ok(f"  {target}: {msg}")
                else:
                    _fail(f"  {target}: {msg}")
        except ValueError as e:
            _fail(str(e))
            sys.exit(1)
        return
    return _route_manage(args)


def _route_manage(args):
    """Manage/use the router backends: models, chat, omni, health."""
    from core import cliui
    action = getattr(args, "action", None)
    if action == "models":
        name = getattr(args, "name", None) or "nain"
        res = router.discover_models(name)
        if not res.get("ok"):
            _fail(f"{name}: {res.get('error')}")
            return
        rows = [[m] for m in res.get("models", [])]
        print(cliui.table(rows, headers=[f"{name} models"], max_w=None))
        print(f"  {len(res.get('models', []))} models")
        return
    if action == "chat":
        name = getattr(args, "name", None) or "nain"
        text = getattr(args, "text", "") or ""
        if not text:
            _fail("usage: atropos route chat <name> \"message\" [--model M]")
            return
        res = router.chat(name, text, model=getattr(args, "model", None))
        if res.get("ok"):
            print(f"  {_C_CYAN}{name}{_C_RESET} ({res.get('model','')}):")
            print(f"  {res.get('text','')}")
        else:
            _fail(f"{name}: {res.get('error')}")
        return
    if action == "omni":
        res = router.omniroute(getattr(args, "omni_args", []) or [])
        print(res.get("output") or (res.get("error") or "(no output)"))
        if not res.get("ok"):
            sys.exit(1)
        return
    if action == "health":
        h = router.health()
        for name, p in h.get("pings", {}).items():
            icon = _C_GREEN + "OK" + _C_RESET if p.get("ok") else _C_RED + "FAIL" + _C_RESET
            lat = f'{p.get("latency_ms")}ms' if p.get("latency_ms") is not None else "—"
            print(f"  [{icon}] {name}: {lat} — {p.get('error') or p.get('model', '')}")
        print(f"  active: {h.get('active')}  all_down: {h.get('all_down')}")
        return
    r = router.get()
    print(f"  active:    {r.get('active','?')}")
    print(f"  model:     {r.get('model','?')}")
    print(f"  base_url:  {r.get('base_url','default') or 'default'}")
    print(f"  available: {', '.join(router.available())}")
    print("  manage:    atropos route models [name] · route chat <name> \"msg\" · route omni <cmd…>")


def cmd_patch(args):
    if args.verify:
        results = patches.verify()
        for r in results:
            if r["applied"]:
                _ok(r["id"])
            else:
                _fail(r["id"])
        sys.exit(0 if all(r["applied"] for r in results) else 1)
    applied, skipped, errors = patches.apply_hacks()
    _ok(f"applied: {len(applied)}")
    for a in applied:
        _ok(f"  {a}")
    for sid, reason in skipped:
        _warn(f"  {sid}: {reason}")
    for e in errors:
        _fail(f"  {e}")
    sys.exit(0 if not errors else 1)


def cmd_init(args):
    print(f"{_C_BOLD}Atropos init{_C_RESET}")
    d = detect.save_runtime()
    _info(f"detected: {d['os']} / python {d['python_version']} / cloud={d['cloud']}")
    home = detect.atropos_home()
    home.mkdir(parents=True, exist_ok=True)
    if not (home / "config.yaml").exists():
        config.save(config.load())
        _ok(f"wrote {home / 'config.yaml'}")
    from core import doctor as _doctor
    for r in _doctor.doctor(fix=True):
        if r["ok"]:
            _ok(f"{r['name']}: {r['msg']}")
        else:
            _fail(f"{r['name']}: {r['msg']}")
    applied, skipped, errors = patches.apply_hacks()
    _ok(f"patches applied: {len(applied)}")
    from core.dashboard import _auth_token
    _info(f"dashboard token: {_auth_token()}")
    _ok("init done. Next: atropos doctor && atropos dashboard")


def cmd_dashboard(args):
    from core import lan, qr
    cfg = config.load()
    d = cfg.get("dashboard", {})
    port = args.port or int(d.get("port", 8787))
    url = f"http://{lan.lan_ip()}:{port}/"
    if args.share:
        print(f"  {_C_BOLD}Atropos dashboard — share{_C_RESET}")
        print(f"  {_C_CYAN}URL:{_C_RESET}        {url}")
        if not args.quiet:
            print()
            for ln in qr.qr_ascii(url.split("//")[1] + "  " + _MOIRAI_TAGLINE):
                print("  " + ln)
        print()
    from core.dashboard import serve
    serve(d.get("host", "127.0.0.1"), port)


def cmd_jailbreak(args):
    from core.jailbreak import scan, apply, apply_all, revert
    if args.status:
        for r in scan():
            state = "OPEN" if r["applied"] else ("BLOCKED" if r["blocked"] else "N/A")
            icon = "🔓" if r["applied"] else "🔒"
            print(f"  {icon} {r['id']:<26} {state:<8} {r['name']}")
    elif args.apply:
        r = apply(args.apply)
        print(json.dumps(r, indent=2, ensure_ascii=False))
    elif args.apply_all:
        for r in apply_all():
            mark = "OK" if r["ok"] else "ERR"
            print(f"  [{mark}] {r['id']}: {r.get('msg', r.get('error',''))}")
    elif args.revert:
        r = revert(args.revert)
        print(json.dumps(r, indent=2, ensure_ascii=False))
    else:
        print("usage: atropos jailbreak --status | --apply <id> | --apply-all | --revert <id>")


def cmd_alert(args):
    from core.alerts import check_and_alert, send_alert
    import shutil
    if args.test:
        ok = send_alert("Test alert from Atropos ✅", force=True)
        _ok("alert sent" if ok else "alert failed")
    elif args.check:
        usage = shutil.disk_usage(str(detect.hermes_home()))
        pct = usage.used / usage.total * 100
        results = check_and_alert(disk_pct=pct)
        _ok(f"alerts sent: {len(results)}")
        for r in results:
            print(f"    {r}")
    elif args.send:
        ok = send_alert(args.send, force=True)
        _ok("sent" if ok else "failed")
    else:
        print("  use --test, --check, or --send 'message'")


