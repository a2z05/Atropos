            "atropos": (
                "PUSH EVERYTHING TO MAX + ZERO DEFECTS — rebuild broken components, optimize all "
                "configs for speed, run FULL test suite with real inputs, fix every detectable issue, "
                "benchmark before/after to prove improvement, ensure ZERO failures AND maximum "
                "performance before reporting success, security audit (no hardcoded secrets, no unsafe "
                "exec), regression tests, docstrings on all public functions, clean code (no TODOs, "
                "no dead imports), self-loop until every test green and every edge case handled"
            ),
            "thinking": "max",
        },
    }

    def _thinking_for(tier_name):
        return tiers.get(tier_name, {}).get("thinking", "medium")

    if args.get or args.effort_action == "get" or (not args.effort_action and not args.tier):
        cfg = config.load()
        current = cfg.get("effort", {"hermes": "medium", "claude": "medium", "atropos": "medium"})
        print(f"  {_C_BOLD}{_C_CYAN}current effort tiers (per harness){_C_RESET}")
        print(f"  {_C_DIM}('*' = max level){_C_RESET}\n")
        for component in ["hermes", "claude", "atropos"]:
            tier = current.get(component, "medium")
            desc = tiers.get(tier, {}).get(component, "") or f"(legacy: {tier})"
            star = f" {_C_YELLOW}★ MAX{_C_RESET}" if tier == "tryhard" else ""
            print(f"    {_C_CYAN}{component:<10}{_C_RESET} {_C_BOLD}{tier:<12}{_C_RESET}{star} — {desc}")
        print()
        print(f"  {_C_DIM}available tiers: {', '.join(tiers.keys())}{_C_RESET}")
    else:
        # per-harness selection
        targets = []
        if getattr(args, "hermes", False): targets.append("hermes")
        if getattr(args, "claude", False): targets.append("claude")
        if getattr(args, "atropos", False): targets.append("atropos")
        if getattr(args, "all", False) or not targets:
            targets = ["hermes", "claude", "atropos"]

        if args.effort_action != "set" or not args.tier:
            _fail("usage: atropos effort set <tier> [--hermes|--claude|--atropos|--all]")
            sys.exit(1)
        tier = args.tier.lower()
        if tier not in tiers:
            _fail(f"unknown tier: {tier}. Available: {', '.join(tiers.keys())}")
            sys.exit(1)

        cfg = config.load()
        current = cfg.get("effort", {"hermes": "medium", "claude": "medium", "atropos": "medium"})
        for t in targets:
            current[t] = tier
        cfg["effort"] = current
        thinking = _thinking_for(tier)

        # only update hermes reasoning_effort when hermes is a target (or all)
        if "hermes" in targets:
            try:
                hconfig = detect.hermes_home() / "config.yaml"
                if hconfig.exists():
                    htext = hconfig.read_text()
                    if "reasoning_effort:" in htext:
                        import re
                        htext = re.sub(r"reasoning_effort:\s*\S+", f"reasoning_effort: {thinking}", htext, count=1)
                    else:
                        htext = htext.replace("model:", f"reasoning_effort: {thinking}\nmodel:", 1)
                    hconfig.write_text(htext)
                    _ok(f"hermes config.yaml reasoning_effort → {thinking}")
            except Exception as e:
                _warn(f"could not update hermes reasoning_effort: {e}")

        config.save(cfg)
        _ok(f"effort set to '{tier}' for: {', '.join(targets)} (thinking={thinking})")
        for t in targets:
            desc = tiers[tier][t]
            print(f"    {t}: {desc}")



