def cmd_effort(args):
    # Effort tiers — mapped to real harness capabilities.
    # Hermes uses Anthropic adaptive effort: minimal/low/medium/high/xhigh/ultra/max
    # Claude Code uses permission modes: acceptEdits, --dangerously-skip-permissions
    # Atropos uses patch thoroughness + test coverage.
    #
    # NEW: per-harness selection — each harness has its OWN tier:
    #   atropos effort set --hermes tryhard           # only hermes
    #   atropos effort set --claude ultracode         # only claude
    #   atropos effort set --atropos tryhard          # only atropos
    #   atropos effort set tryhard                    # ALL three + reasoning
    #   atropos effort set --all tryhard              # same as above
    #   atropos effort --get                          # show per-harness tiers
    #
    # tryhard is the absolute top for EVERY harness — maximum performance,
    # maximum reasoning, maximum verification. Everything else is below it.
    tiers = {
        "minimal": {
            "hermes": "fastest responses, least reasoning tokens, short answers",
            "claude": "minimal edits, acceptEdits mode, no test writing",
            "atropos": "doctor only, no auto-fix, no backup",
            "thinking": "low",
        },
        "low": {
            "hermes": "low reasoning, quick answers, minimal tool use",
            "claude": "basic coding, acceptEdits, single-file only",
            "atropos": "doctor + status, skip patches",
            "thinking": "low",
        },
        "medium": {
            "hermes": "balanced reasoning, standard tool use, normal responses",
            "claude": "standard coding, acceptEdits, multi-file edits",
            "atropos": "full doctor + patch verify + config get/set",
            "thinking": "medium",
        },
        "high": {
            "hermes": "deep reasoning, long context, exhaustive research",
            "claude": "agentic coding, multi-file, refactors, write tests",
            "atropos": "doctor --fix + patch apply + backup + verify all",
            "thinking": "high",
        },
        "xhigh": {
            "hermes": "maximum reasoning on Claude 4.7+, very deep analysis",
            "claude": "full agentic mode, acceptEdits, complex multi-step tasks",
            "atropos": "aggressive patching + full backup + doctor verify + self-heal",
            "thinking": "xhigh",
        },
        "ultracode": {
            "hermes": "ultra reasoning, every tool, multi-delegate, deep reasoning",
            "claude": "claude-code --permission-mode acceptEdits, write entire projects, refactor codebases, self-test everything",
            "atropos": "full pipeline: backup -> update -> patch -> doctor -> verify -> test suite, zero known issues",
            "thinking": "max",
        },
        "tryhard": {
            "hermes": (
                "ABSOLUTE MAXIMUM PERFORMANCE + ZERO DEFECTS — exhaustive research, "
                "multi-delegate in parallel, no stop until answer is perfect AND verified, "
                "every possible optimization applied, every test green, every edge case covered, "
                "every TODO removed, every docstring written, every security check passed, "
                "benchmark before and after to prove improvement, self-loop until zero failures"
            ),
            "claude": (
                "claude-code with ALL permissions + acceptEdits — write + test + refactor entire "
                "codebases, recursive self-debug loop (run code -> see error -> fix -> re-run -> repeat), "
                "optimize performance and readability, verify with py_compile AND unit tests AND real "
                "execution with real inputs, clean up all TODOs/FIXMEs/HACKs, no dead imports, "
                "every function docstringed, benchmark before/after, regression tests pass, "
                "full security audit (no os.system, no hardcoded secrets, tmp cleanup), "
                "self-loop until ZERO failures across every possible path"
            ),
            "atropos": (
                "PUSH EVERYTHING TO MAX + ZERO DEFECTS — rebuild broken components, optimize all "
                "configs for speed, run FULL test suite with real inputs, fix every detectable issue, "
                "benchmark before/after to prove improvement, ensure ZERO failures AND maximum "
                "performance before reporting success, security audit (no hardcoded secrets, no unsafe "
                "exec), regression tests, docstrings on all public functions, clean code (no TODOs, "
                "no dead imports), self-loop until every test green and every edge case handled"
            ),
            "thinking": "max",
        },
    }

    def _thinking_for(tier_name):
        return tiers.get(tier_name, {}).get("thinking", "medium")

    if args.get or args.effort_action == "get" or (not args.effort_action and not args.tier):
        cfg = config.load()
        current = cfg.get("effort", {"hermes": "medium", "claude": "medium", "atropos": "medium"})
        print(f"  {_C_BOLD}{_C_CYAN}current effort tiers (per harness){_C_RESET}")
        print(f"  {_C_DIM}('*' = max level){_C_RESET}\n")
        for component in ["hermes", "claude", "atropos"]:
            tier = current.get(component, "medium")
            desc = tiers.get(tier, {}).get(component, "") or f"(legacy: {tier})"
            star = f" {_C_YELLOW}★ MAX{_C_RESET}" if tier == "tryhard" else ""
            print(f"    {_C_CYAN}{component:<10}{_C_RESET} {_C_BOLD}{tier:<12}{_C_RESET}{star} — {desc}")
        print()
        print(f"  {_C_DIM}available tiers: {', '.join(tiers.keys())}{_C_RESET}")
    else:
        # per-harness selection
        targets = []
        if getattr(args, "hermes", False): targets.append("hermes")
        if getattr(args, "claude", False): targets.append("claude")
        if getattr(args, "atropos", False): targets.append("atropos")
        if getattr(args, "all", False) or not targets:
            targets = ["hermes", "claude", "atropos"]

        if args.effort_action != "set" or not args.tier:
            _fail("usage: atropos effort set <tier> [--hermes|--claude|--atropos|--all]")
            sys.exit(1)
        tier = args.tier.lower()
        if tier not in tiers:
            _fail(f"unknown tier: {tier}. Available: {', '.join(tiers.keys())}")
            sys.exit(1)

        cfg = config.load()
        current = cfg.get("effort", {"hermes": "medium", "claude": "medium", "atropos": "medium"})
        for t in targets:
            current[t] = tier
        cfg["effort"] = current
        thinking = _thinking_for(tier)

        # only update hermes reasoning_effort when hermes is a target (or all)
        if "hermes" in targets:
            try:
                hconfig = detect.hermes_home() / "config.yaml"
                if hconfig.exists():
                    htext = hconfig.read_text()
                    if "reasoning_effort:" in htext:
                        import re
                        htext = re.sub(r"reasoning_effort:\s*\S+", f"reasoning_effort: {thinking}", htext, count=1)
                    else:
                        htext = htext.replace("model:", f"reasoning_effort: {thinking}\nmodel:", 1)
                    hconfig.write_text(htext)
                    _ok(f"hermes config.yaml reasoning_effort -> {thinking}")
            except Exception as e:
                _warn(f"could not update hermes reasoning_effort: {e}")

        config.save(cfg)
        _ok(f"effort set to '{tier}' for: {', '.join(targets)} (thinking={thinking})")
        for t in targets:
            desc = tiers[tier][t]
            print(f"    {t}: {desc}")



def cmd_settings(args):
    """Settings hub: table / get / set / export / import (typed + validated)."""
    if not args.action:
        groups = {}
        for key, spec in settings.schema().items():
            if spec.get("readonly"):
                continue
            groups.setdefault(spec["group"], []).append(key)
        for gname, keys in groups.items():
            print(f"  {_C_BOLD}{_C_CYAN}[{gname}]{_C_RESET}")
            for key in keys:
                val = settings.get(key)
                if settings.is_secret(key) and val:
                    val = settings.SECRET_MASK
                if isinstance(val, dict) or isinstance(val, list):
                    val = json.dumps(val, ensure_ascii=False)
                print(f"    {key:<32} {val}")
        return
    if args.action == "get":
        if not args.key:
            _fail("usage: atropos settings get <key>")
            sys.exit(1)
        if args.key not in settings.schema():
            _fail(f"unknown setting: {args.key}")
            sys.exit(1)
        val = settings.get(args.key)
        if settings.is_secret(args.key) and val:
            val = settings.SECRET_MASK
        print(json.dumps(val, ensure_ascii=False) if isinstance(val, (dict, list)) else val)
        return
    if args.action == "set":
        if not args.key or args.value is None:
            _fail("usage: atropos settings set <key> <value>")
            sys.exit(1)
        if args.key not in settings.schema():
            _fail(f"unknown setting: {args.key}")
            sys.exit(1)
        parsed = _coerce(args.value)
        try:
            settings.set(args.key, parsed)
        except ValueError as e:
            _fail(f"rejected: {e}")
            sys.exit(1)
        val = settings.get(args.key)
        if settings.is_secret(args.key):
            val = settings.SECRET_MASK
        _ok(f"{args.key} = {json.dumps(val, ensure_ascii=False) if isinstance(val, (dict, list)) else val}")
        return
    if args.action == "export":
        print(settings.export_yaml(include_secrets=args.secrets), end="")
        return
    if args.action == "import":
        if not args.value:
            _fail("usage: atropos settings import <yaml-file>")
            sys.exit(1)
        p = Path(args.value)
        if not p.exists():
            _fail(f"file not found: {args.value}")
            sys.exit(1)
        try:
            settings.import_yaml(p.read_text(encoding="utf-8"))
        except ValueError as e:
            _fail(f"import rejected: {e}")
            sys.exit(1)
        _ok(f"imported: {p}")
