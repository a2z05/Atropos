def cmd_sessions(args):
    """Single Session Engine (v19 M): one session for everything.

    list | current | threads | route <id> | merge <a> <b> | pin <id>
    | stats | explain <msg> | mode [unified|auto-split|hybrid]
    """
    from core import session_engine as se, settings, cliui
    surface = args.surface or "cli"
    if args.action == "list":
        rows = []
        for s in se.sessions_detailed(surface):
            rows.append([s["id"][:8], s["title"][:30],
                         "✓" if s["auto_split"] else "",
                         "/".join(t["label"] for t in s["threads"])[:24],
                         str(s["message_count"])])
        print(cliui.table(rows, headers=["id", "title", "split", "threads", "msgs"]))
    elif args.action == "current":
        sid = se._current.get(surface, "")
        info = {}
        for s in se.sessions_detailed(surface):
            if s["id"] == sid:
                info = s
                break
        print(f"  current session: {sid[:8]} {info.get('title', '')[:40]}")
        print(f"  mode: {se.surface_mode(surface)}  thread: {se._threads.get(surface, '') or '—'}")
    elif args.action == "threads":
        rows = [[t["label"], t["msg_count"]]
                for s in se.sessions_detailed(surface) for t in s["threads"]]
        print(cliui.table(rows, headers=["thread", "msgs"]) if rows else "  no threads yet")
    elif args.action == "route":
        if not args.args:
            _fail("usage: atropos sessions route <session-id>")
            return
        r = se.switch_session(surface, args.args[0])
        _ok(f"routed to {args.args[0][:8]}") if r.get("ok") else _fail(r.get("error", "route failed"))
    elif args.action == "merge":
        if not args.args or len(args.args) < 2:
            _fail("usage: atropos sessions merge <sessionA> <sessionB>")
            return
        r = se.merge_sessions(surface, args.args[0], args.args[1])
        _ok(f"merged into {r['merged_into'][:8]}") if r.get("ok") else _fail(r.get("error", "merge failed"))
    elif args.action == "pin":
        if not args.args:
            _fail("usage: atropos sessions pin <session-id>")
            return
        se.pin_session(surface, args.args[0])
        _ok(f"pinned {args.args[0][:8]}")
    elif args.action == "stats":
        st = se.stats()
        print(cliui.table([[k, str(v)] for k, v in st.items()], headers=["key", "value"]))
    elif args.action == "explain":
        if not args.args:
            _fail("usage: atropos sessions explain <message>")
            return
