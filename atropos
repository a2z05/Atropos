#!/usr/bin/env python3
"""Atropos CLI — single entrypoint, stdlib only.

Usage:
  atropos doctor [--fix] [--json]
  atropos status
  atropos update [--check]
  atropos guest [--status|--toggle]
  atropos config get <key> | config set <key> <value>
  atropos logs [--tail N]
  atropos route [set <name>]
  atropos patch [--verify|--apply]
  atropos init
  atropos dashboard [--port N]
  atropos detect
  atropos version
  atropos watch [--daemon] [--interval N]
  atropos backup [--list|--restore <name>|--prune N]
  atropos skills [--list|--sync|--export|--import [name]]
  atropos effort [set <tier>] [get]   # hermes/claude/atropos effort tiers
"""
