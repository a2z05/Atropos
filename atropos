def cmd_repl(args):
    """Interactive REPL: history, tab-complete, ?, slash-commands, Ctrl+C safe."""
    from core import cliui

    def dispatch(cmd):
        parts = cmd.split()
        name = parts[0]
        sub = argparse.Namespace(**vars(args))
        sub.cmd = name
        handler = handlers.get(name)
        if not handler:
            print(f"  unknown command: {name}")
            return
        # rebuild a per-command namespace with the subcommand's parsed defaults
        try:
            handler(sub)
        except SystemExit:
            pass

    cliui.repl(dispatch)


# ── menu dispatch helper (used by cliui.menu + cliui.repl) ───────────────
def _dispatch_cmd(cmd):
    """Run a CLI command string through the handlers (menu/REPL dispatch)."""
    parts = cmd.split(maxsplit=1)
    name = parts[0]
    handler = handlers.get(name)
    if not handler:
        print(f"  unknown command: {name}")
        return
    ns = argparse.Namespace(cmd=name, lang=None, theme=None)
    if len(parts) > 1:
        rest = parts[1]
        for flag, val in zip(rest.split()[::2], rest.split()[1::2]):
            if flag.startswith("--"):
                setattr(ns, flag.lstrip("-").replace("-", "_"), val)
        if name == "sessions":
            # positional action + free args (route/merge/explain/mode)
            words = [w for w in rest.split() if not w.startswith("--")]
            ns.action = words[0] if words else "list"
            ns.args = words[1:] or None
            ns.surface = getattr(ns, "surface", "cli")
    try:
        handler(ns)
    except SystemExit:
        pass


# ── no-subcommand dispatch (settings.cli.default_action) ────────────────
def _dispatch_default(ap):
    """What a bare `atropos` (no subcommand) does, per cli.default_action.

    cli          → status overview (mouse-friendly, no TTY needed)
    dashboard    → start the web dashboard (prints URL + QR)
    both         → dashboard in the background, then this status overview
                   with a pointer to the dashboard URL

    On first run the setup wizard launches automatically. On Railway, the
    dashboard binds to 0.0.0.0 with the $PORT env var.
    """
    # ── first-run: auto-launch setup wizard ────────────────────────────
    if detect.is_first_run():
        cloud = detect.detect_cloud()
        if cloud == "railway":
            # Railway headless: no TTY → skip wizard, run silent init
            from core import setup_wizard
            setup_wizard._configure_first_time()
            detect.mark_setup_done()
            _info("first-run init complete (Railway headless)")
        elif _IS_TTY:
            from core.setup_wizard import run_wizard
            run_wizard()
            detect.mark_setup_done()
            _info("setup complete — welcome to Atropos!")
        else:
            # Non-TTY, non-Railway: run init silently
            cmd_init(argparse.Namespace())
            detect.mark_setup_done()

    action = "both"
    try:
        action = settings.get("cli.default_action", "both") or "both"
    except Exception:
        pass
    if action == "cli":
        # "cli" = interactive chat REPL
        cmd_repl(argparse.Namespace())
        sys.exit(0)
    if action == "menu":
        from core import cliui
        cliui.menu(_dispatch_cmd)
        sys.exit(0)
    if action == "repl":
        cmd_repl(argparse.Namespace())
        sys.exit(0)
    if action == "dashboard":
        cmd_dashboard(argparse.Namespace(port=None, share=True, quiet=False))
        sys.exit(0)
    if action == "both":
        from core import lan
        cfg = config.load()
        d = cfg.get("dashboard", {})
        # Railway: read port from $PORT env var
        cloud = detect.detect_cloud()
        if cloud == "railway":
            port = int(os.environ.get("PORT", d.get("port", 8787)))
        else:
            port = int(d.get("port", 8787))
        url = f"http://{lan.lan_ip()}:{port}/"
        try:
            import subprocess as _sp
            _sp.Popen(
                [sys.executable, str(Path(__file__).resolve()), "dashboard", "--port", str(port)],
                stdout=_sp.DEVNULL, stderr=_sp.DEVNULL,
                start_new_session=os.name != "nt",
            )
            _info(f"dashboard started in background: {url}")
        except Exception as e:
            _warn(f"could not start dashboard in background: {e}")
        cmd_status(argparse.Namespace())
        sys.exit(0)
    cmd_status(argparse.Namespace())


