def _print_op(d):
    """Pretty-print a dict result (sync/wizard/etc)."""
    print(json.dumps(d, indent=2, ensure_ascii=False))


def _print_update_result(r):
    """Shared tail for apply/ai-check output."""
    if r.get("up_to_date"):
        _ok(f"up to date @ {r.get('head')}")
        sys.exit(0)
    if r.get("rolled_back"):
        _fail("rolled back to previous revision")
    for a in r.get("applied", []):
        _ok(f"patch: {a}")
    for sid, reason in r.get("skipped", []):
        _warn(f"  {sid}: {reason}")
    for e in r.get("errors", []):
        _fail(f"patch error: {e}")
    for c in r.get("doctor", []):
        icon = _C_GREEN + "OK" + _C_RESET if c["ok"] else _C_RED + "FAIL" + _C_RESET
        print(f"  doctor: {icon}  {c['name']}: {c['msg']}")
    if r.get("backup"):
        _info(f"backup: {r['backup']}")
    if r.get("tests"):
        t = r["tests"]
        status = "OK" if t.get("ok") else "FAIL"
        icon = _C_GREEN + status + _C_RESET if t.get("ok") else _C_RED + status + _C_RESET
        print(f"  tests: {icon}  {(t.get('output') or '').strip().splitlines()[-1:]}")
    sys.exit(0 if r.get("ok") else 1)


def cmd_update(args):
    if args.set_auto:
        try:
            from core import settings as _st
            _st.set("update.auto", args.set_auto)
            _ok(f"update.auto = {args.set_auto}")
        except ValueError as e:
            _fail(str(e))
            sys.exit(1)
        return

    # ── 1. Check Atropos itself from GitHub ──────────────────────────────
    print(f"\n  {_C_BOLD}Checking Atropos updates...{_C_RESET}")
    atropos_repo = str(Path(__file__).resolve().parent)
    try:
        import subprocess as _sp
        # Fetch latest from origin
        _sp.run(["git", "-C", atropos_repo, "fetch", "origin", "main"],
                capture_output=True, timeout=30)
        head = _sp.run(["git", "-C", atropos_repo, "rev-parse", "--short", "HEAD"],
                       capture_output=True, text=True, timeout=10).stdout.strip()
        remote = _sp.run(["git", "-C", atropos_repo, "rev-parse", "--short", "origin/main"],
                         capture_output=True, text=True, timeout=10).stdout.strip()
        behind = _sp.run(["git", "-C", atropos_repo, "rev-list", "--count", "HEAD..origin/main"],
                         capture_output=True, text=True, timeout=10).stdout.strip() or "0"

        if behind == "0" or head == remote:
            _ok(f"Atropos is up to date @ {head}")
        else:
            _warn(f"Atropos is behind by {behind} commit(s): {head} → {remote}")
            try:
                ans = input(f"  Update Atropos now? [Y/n] ").strip().lower()
            except EOFError:
                ans = "y"
            if ans not in ("n", "no"):
                _info("Pulling latest Atropos...")
                pull = _sp.run(["git", "-C", atropos_repo, "pull", "--ff-only", "origin", "main"],
                               capture_output=True, text=True, timeout=60)
                if pull.returncode == 0:
                    new_head = _sp.run(["git", "-C", atropos_repo, "rev-parse", "--short", "HEAD"],
                                       capture_output=True, text=True, timeout=10).stdout.strip()
                    _ok(f"Atropos updated: {head} → {new_head}")
                    # Reinstall the CLI
                    _info("Reinstalling atropos CLI...")
                    _sp.run([sys.executable, str(Path(__file__).resolve()), "install"],
                            capture_output=True, timeout=30)
                    _ok("CLI reinstalled")
                else:
                    _fail(f"pull failed: {pull.stderr[:200]}")
    except Exception as e:
        _fail(f"Atropos check failed: {e}")

    # ── 2. Ask about hermes-agent ───────────────────────────────────────
    repo = detect.hermes_agent()
    if repo:
        print()
        try:
            ans = input(f"  Check hermes-agent updates? [y/N] ").strip().lower()
        except EOFError:
            ans = "n"
        if ans in ("y", "yes"):
            _update_hermes(repo, args)
    else:
        _info("hermes-agent not found — skipping")

    # ── 3. Ask about Claude Code ────────────────────────────────────────
    claude = detect._find_claude()
    if claude:
        print()
        try:
            ans = input(f"  Check Claude Code updates? [y/N] ").strip().lower()
        except EOFError:
            ans = "n"
        if ans in ("y", "yes"):
            _update_claude(claude)
    else:
        _info("Claude Code not found — skipping")


def _update_hermes(repo, args):
    """Check and optionally update hermes-agent."""
    print(f"\n  {_C_BOLD}Checking hermes-agent...{_C_RESET}")
    try:
        r = update.update_check(repo)
        if r.get("up_to_date"):
            _ok(f"hermes-agent is up to date @ {r['head']}")
        elif r.get("ok"):
            _warn(f"hermes-agent is behind: {r.get('behind')} commits")
            try:
                ans = input(f"  Update hermes-agent now? [y/N] ").strip().lower()
            except EOFError:
                ans = "n"
            if ans in ("y", "yes"):
                _info("Applying hermes-agent update...")
                res = update.apply_update(repo)
                if res.get("ok") and res.get("head") != res.get("prev_head"):
                    _ok(f"hermes-agent updated: {res.get('prev_head')} → {res.get('head')}")
                    # Apply patches
                    from core import patches as _patches
                    applied, skipped, errors = _patches.apply_hacks()
                    _ok(f"Patches applied: {len(applied)}")
                elif res.get("up_to_date"):
                    _ok(f"up to date @ {res.get('head')}")
                else:
                    _fail(res.get("error", "update failed"))
        else:
            _fail(f"hermes-agent check failed: {r.get('error')}")
    except Exception as e:
        _fail(f"hermes-agent update error: {e}")


def _update_claude(claude_path):
    """Check and optionally update Claude Code via npm."""
    print(f"\n  {_C_BOLD}Checking Claude Code...{_C_RESET}")
    import subprocess as _sp
    try:
        cur = _sp.run(["claude", "--version"], capture_output=True, text=True, timeout=10)
        cur_ver = cur.stdout.strip().split("\n")[0] if cur.returncode == 0 else "unknown"
        _info(f"Current version: {cur_ver}")

        npm_out = _sp.run(["npm", "view", "@anthropic-ai/claude-code", "version"],
                          capture_output=True, text=True, timeout=15)
        latest = npm_out.stdout.strip() if npm_out.returncode == 0 else ""
        if latest and latest != cur_ver:
            _warn(f"New version available: {latest}")
            try:
                ans = input(f"  Update Claude Code to {latest}? [y/N] ").strip().lower()
            except EOFError:
                ans = "n"
            if ans in ("y", "yes"):
                _info("Updating Claude Code...")
                up = _sp.run(["npm", "install", "-g", "@anthropic-ai/claude-code"],
                             capture_output=True, text=True, timeout=120)
                if up.returncode == 0:
                    _ok(f"Claude Code updated to {latest}")
                else:
                    _fail(f"npm update failed: {up.stderr[:200]}")
        else:
            _ok(f"Claude Code is up to date ({cur_ver})")
    except FileNotFoundError:
        _fail("npm not found — can't update Claude Code")
    except Exception as e:
        _fail(f"Claude Code check failed: {e}")


def cmd_install(args):
    """Make `atropos` runnable from any directory (PATH integration).

    Symlinks (or copies, when the filesystem forbids symlinks — e.g.
    Windows without admin) the repo `atropos` script into a bin dir on
    PATH. Defaults to ~/.local/bin; `--bin <dir>` overrides. Prints the
    exact next step so the command works from a fresh shell.
    """
    from core import qr  # lazy: only used for the QR hint below
    self_path = Path(__file__).resolve()
    bin_dir = Path(args.bin_dir).expanduser() if getattr(args, "bin_dir", None) else (
        Path.home() / ".local" / "bin")

    try:
        bin_dir.mkdir(parents=True, exist_ok=True)
        target = bin_dir / "atropos"
        # remove stale link/copy first
        if target.is_symlink() or target.exists():
            target.unlink()
        try:
            os.symlink(str(self_path), str(target))
            mode = "symlinked"
        except (OSError, NotImplementedError):
            # copy the whole runtime next to the script so the copy is
            # self-contained (core/, VERSION, templates/, hacks/, patches/,
            # dashboard/ are all resolved relative to the script)
            for sub in ("core", "templates", "hacks", "patches", "dashboard"):
                src = self_path.resolve().parent / sub
                if src.is_dir():
                    shutil.copytree(src, bin_dir / sub, dirs_exist_ok=True)
            for f in ("VERSION", "icon.png"):
                sf = self_path.resolve().parent / f
                if sf.exists():
                    shutil.copy2(str(sf), bin_dir / f)
            shutil.copy2(str(self_path), str(target))
            mode = "copied"
        if os.name != "nt":
            os.chmod(str(target), 0o755)
        _ok(f"atropos {mode} to {target}")
    except Exception as e:
        _fail(f"could not install to {bin_dir}: {e}")
        if bin_dir != Path("/usr/local/bin"):
            _warn("try: atropos install --bin /usr/local/bin  (with sudo)")
        sys.exit(1)

    # is the target dir already on PATH?
    path_dirs = {os.path.abspath(p) for p in os.environ.get("PATH", "").split(os.pathsep)}
    if os.path.abspath(str(bin_dir)) not in path_dirs:
        _warn(f"{bin_dir} is not on your PATH yet")
        if os.name == "nt":
            _info("Windows: add it to PATH via: setx PATH \"%PATH%;' + str(bin_dir) + '\"")
        else:
            _info(f"add it to your shell profile, e.g.:  export PATH=\"$HOME/.local/bin:$PATH\"")
    _ok("Atropos available as: atropos — try it from any directory")
    if _IS_TTY:
        try:
            print()
            for ln in qr.qr_ascii("atropos is installed — the unturnable"):
                print("  " + ln)
        except Exception:
            pass


