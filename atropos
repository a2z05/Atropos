def cmd_identity(args):
    """Universal identity: list|edit|mode|sync|diff|restore."""
    from core import identity
    if not args.action or args.action == "list":
        for f in identity.list_files():
            print(f"  {f['name']:<16} {f.get('mode','shared'):<12} {f.get('size',0):>8}B"
                  f"  consumed: {', '.join(f.get('consumed_by', []))}")
        return
    if args.action == "mode":
        try:
            identity.mode(args.name, args.mode)
            _ok(f"{args.name} -> {args.mode}")
        except ValueError as e:
            _fail(str(e))
            sys.exit(1)
        return
    if args.action == "sync":
        try:
            res = identity.sync(args.name)
            _ok(f"synced: {args.name} {res}")
        except ValueError as e:
            _fail(str(e))
            sys.exit(1)
        return
    if args.action == "diff":
        for d in identity.diff(args.name):
            state = "DIFFERS" if d["differs"] else "same"
            print(f"  {state:<8} {d['target']}")
        return
    if args.action == "restore":
        try:
            identity.restore(args.name, int(args.n))
            _ok(f"restored {args.name} from snapshot {args.n}")
        except (ValueError, FileNotFoundError) as e:
            _fail(str(e))
            sys.exit(1)
        return
    if args.action == "edit":
        content = sys.stdin.read() if not args.content else args.content
        try:
            res = identity.save(args.name, content)
            if res.get("conflict"):
                _warn(f"conflict on {res['target']} — resolve via dashboard or `identity sync --force`")
            else:
                _ok(f"saved: {args.name}")
        except (ValueError, FileNotFoundError) as e:
            _fail(str(e))
            sys.exit(1)
        return
    _fail("usage: atropos identity list|edit|mode|sync|diff|restore")
    sys.exit(1)


