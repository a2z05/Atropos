def cmd_ai_mod(args):
    """AI self-modification surface (v18 G).

    status   — engine mode + pending attempts
    preview  — diagnose + rewrite failed patches (no apply)
    apply    — apply a rewritten patch after tests+doctor (confirm-gated)
    history  — recent attempts from update_ai.json
    """
    from core import update_ai
    if args.action == "status":
        from core import settings as _st
        mode = _st.get("update-ai.mode", "manual")
        auto_fix = _st.get("update.auto_ai", False)
        state = update_ai.failed_patch_state()
        pending = len(state.get("failed_patches", []))
        _info(f"update-ai.mode={mode} · update.auto_ai={auto_fix} · "
              f"pending failed patches: {pending}")
        return
    if args.action == "preview":
        r = update_ai.ai_check(update_ai.failed_patch_state())
        if not r.get("ok", True):
            _fail(r.get("reason", "preview unavailable"))
            sys.exit(1)
        for p in r.get("previews", []):
            _ok(f"{p['attempt']['patch_id']}: {p['attempt']['status']} "
                f"({p['attempt']['id']})")
        print(json.dumps(r, indent=2, ensure_ascii=False)[:4000])
        return
    if args.action == "history":
        hist = update_ai.load_history().get("attempts", [])
        if not hist:
            _info("no AI update attempts yet")
            return
        for a in hist[-10:]:
            _info(f"{a.get('id')}: {a.get('patch_id')} → {a.get('status')} "
                  f"({a.get('current_version')} → {a.get('upstream_version')})")
        return
    # apply <attempt_id>
    if not args.attempt_id:
        _fail("usage: atropos ai-mod apply <attempt_id>")
        sys.exit(1)
    res = update_ai.apply_ai(args.attempt_id, confirm=False)
    if not res.get("ok") and res.get("reason") == "not confirmed":
        _info(f"attempt {args.attempt_id} is dirty — running full verify pass")
        res = update_ai.apply_ai(args.attempt_id, confirm=True)
    print(json.dumps(res, indent=2, ensure_ascii=False))
    sys.exit(0 if res.get("ok") else 1)


def cmd_approve(args):
    """Dangerous-command approval (v18 A.11 Hermes port).

    check   — test a command against the detection rules (no prompt)
    mode    — show/set approvals.mode (manual|smart|off)
    allow   — add a command to the permanent allowlist
    deny    — add a glob to approvals.deny (unconditional)
    pending — list queued gateway approvals waiting for a human
    resolve — answer a pending approval: approve|deny [session|always]
    """
    from core import approve, settings
    if args.action == "check":
        if not args.command:
            _fail("usage: atropos approve check <command>")
            return
        cmd = " ".join(args.command)
        is_hard, hard_desc = approve.detect_hardline_command(cmd)
        is_dang, _pk, desc = approve.detect_dangerous_command(cmd)
        if is_hard:
            _fail(f"HARDLINE: {hard_desc}")
        elif is_dang:
            _warn(f"DANGEROUS: {desc}")
        else:
            _ok("safe — no dangerous pattern matched")
        return
    if args.action == "mode":
        value = (args.value or (args.command[0] if args.command else "") or "").strip()
        if value:
            settings.set("approvals.mode", value)
        _info(f"approvals.mode = {settings.get('approvals.mode')}")
        return
    if args.action == "allow":
        if not args.command:
            _fail("usage: atropos approve allow <command>")
            return
        lst = list(settings.get("approvals.allowlist", []) or [])
        item = " ".join(args.command)
        if item not in lst:
            lst.append(item)
        settings.set("approvals.allowlist", lst)
        _ok(f"allowlisted: {item}")
        return
    if args.action == "deny":
        if not args.command:
            _fail("usage: atropos approve deny <glob>")
            return
        lst = list(settings.get("approvals.deny", []) or [])
        item = " ".join(args.command)
        if item not in lst:
            lst.append(item)
        settings.set("approvals.deny", lst)
        _ok(f"deny rule added (unconditional): {item}")
        return
    if args.action == "pending":
        key = approve.get_current_session_key()
        if not approve.has_blocking_approval(key):
            _info("no pending approvals")
            return
        with approve._lock:
            q = list(approve._gateway_queues.get(key, []))
        for e in q:
            _info(f"  {e.data.get('description', '?')}")
        return
    if args.action == "resolve":
        if not args.choice:
            _fail("usage: atropos approve resolve approve|deny [session|always]")
            return
        key = approve.get_current_session_key()
        choice = "always" if args.scope == "always" else (
            "session" if args.scope == "session" else (
                "once" if args.choice == "approve" else "deny"))
        n = approve.resolve_gateway_approval(key, choice, resolve_all=False)
        _ok(f"resolved {n} pending approval(s) as {choice}")
        return
    _fail("usage: atropos approve check|mode|allow|deny|pending|resolve")


