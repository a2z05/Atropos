def cmd_agent(args):
    """One agent per job: list / create / edit / delete / run / status."""
    from core import agents, cliui
    if args.action == "list":
        rows = [[a["name"], a.get("description", ""), a.get("harness", "auto"),
                 a.get("effort", "medium")] for a in agents.list_agents()]
        print(cliui.table(rows, headers=["name", "description", "harness", "effort"]))
        if not rows:
            print(cliui.dim("  no agents yet — run `atropos agent create`"))
    elif args.action == "create":
        name = args.name or cliui.text("agent name", "")
        if not name:
            _fail("name required")
            return
        desc = cliui.text("description", "")
        prompt = cliui.text("prompt (what it does)", "")
        harness = ["auto", "clotho", "lachesis", "atropos"][
            cliui.select("which harness", ["auto", "clotho (hermes)", "lachesis (claude)", "atropos (self)"])]
        effort = cliui.text("effort tier", "medium")
        try:
            a = agents.save_agent({"name": name, "description": desc, "prompt": prompt,
                                   "harness": harness, "model": None, "effort": effort,
                                   "tools": ["*"], "permissions": "default"})
            _ok(f"agent {a['name']} created")
        except ValueError as e:
            _fail(str(e))
    elif args.action == "edit" and args.name:
        a = agents.get_agent(args.name)
        if not a:
            _fail(f"unknown agent: {args.name}")
            return
        a["prompt"] = cliui.text("prompt", a.get("prompt", ""))
        a["effort"] = cliui.text("effort", a.get("effort", "medium"))
        agents.save_agent(a)
        _ok(f"agent {a['name']} updated")
    elif args.action == "delete" and args.name:
        if agents.delete_agent(args.name):
            _ok(f"agent {args.name} deleted")
        else:
            _fail(f"unknown agent: {args.name}")
    elif args.action == "run" and args.name:
        task = " ".join(args.task or [])
        rec = agents.run_agent(args.name, task)
        if rec.get("ok"):
            _ok(f"[{rec.get('harness')}] {rec.get('result', '')[:200]}")
        else:
            _fail(rec.get("error", "run failed"))
    elif args.action == "status":
        runs = agents.recent_runs(10)
        rows = [[r["agent"], r["harness"], "✓" if r.get("ok") else "✗",
                 r.get("ts", "")[11:19]] for r in runs]
        print(cliui.table(rows, headers=["agent", "harness", "ok", "time"]))
        if not rows:
            print(cliui.dim("  no runs yet"))
    else:
        _fail("usage: atropos agent list | create | edit <name> | delete <name> | run <name> [task] | status")


