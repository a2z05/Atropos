def cmd_mcp(args):
    """Universal MCP registry: list|add|remove|enable|disable|test|rescan|import --from <h>."""
    from core import mcp
    if not args.action or args.action == "list":
        entries = mcp.list_servers()
        if not entries:
            _info("no MCP servers registered (run `atropos mcp rescan`)")
            return
        _print_table([[e["name"], e["type"], e["source"],
                       "on" if e["enabled"] else "off",
                       e.get("mode", "shared"), "adopted" if e.get("adopted") else "pending"]
                      for e in entries],
                     ["name", "type", "source", "state", "mode", "status"])
        return
    if args.action == "rescan":
        res = mcp.rescan()
        _info(f"found {len(res.get('found', []))} servers; added {len(res.get('added', []))}")
        for s in res.get("added", []):
            print(f"  + {s['name']} (source: {s['source']})")
        return
    if args.action == "import":
        res = mcp.rescan()
        pending = [s for s in res.get("added", [])]
        if not pending:
            _info("nothing new to import")
            return
        for s in pending:
            print(f"  + {s['name']} (source: {s['source']})")
        if not getattr(args, "yes", False):
            _info("run `atropos mcp adopt` to adopt them (ask-first)")
        return
    if args.action == "adopt":
        res = mcp.adopt(args.name or "all")
        _ok(f"adopted: {res}")
        return
    if args.action == "add":
        try:
            mcp.add(name=args.name, type_=args.mcp_type, command=args.command, url=args.url)
            _ok(f"server added: {args.name}")
        except ValueError as e:
            _fail(str(e))
            sys.exit(1)
        return
    from core import extensions
    if not args.name:
        _fail("usage: atropos mcp list|add|remove|enable|disable|test|rescan|adopt [name]")
        sys.exit(1)
    try:
        if args.action == "remove":
            mcp.remove(args.name)
            _ok(f"removed: {args.name}")
        elif args.action == "enable":
            mcp.enable(args.name)
            _ok(f"enabled: {args.name}")
        elif args.action == "disable":
            mcp.disable(args.name)
            _ok(f"disabled: {args.name}")
        elif args.action == "test":
            st = mcp.status(args.name)
            _ok(f"{args.name}: {st}")
    except (FileNotFoundError, ValueError) as e:
        _fail(str(e))
        sys.exit(1)


