def _print_table(rows, headers=None):
    """Simple aligned text table for CLI output."""
    if not rows:
        _info("(empty)")
        return
    if headers:
        rows = [headers] + rows
    widths = [max(len(str(r[i])) for r in rows) for i in range(len(rows[0]))]
    for i, r in enumerate(rows):
        line = "  " + "  ".join(str(c).ljust(widths[j]) for j, c in enumerate(r))
        if i == 0 and headers:
            print(f"  {_C_BOLD}{line.strip()}{_C_RESET}")
        else:
            print(line)


